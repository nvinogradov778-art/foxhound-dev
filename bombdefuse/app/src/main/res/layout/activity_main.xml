<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A0A"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:orientation="vertical"
        android:background="@drawable/lcd_bg"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/ledStatus"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/led_off" />

            <TextView
                android:id="@+id/lcdHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="BOMB"
                android:textColor="#2ECC71"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:letterSpacing="0.4"
                android:gravity="center" />

            <TextView
                android:id="@+id/lcdPhase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOCKED"
                android:textColor="#FF6B35"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#332ECC71"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/lcdLine1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KEYPAD LOCKED"
            android:textColor="#2ECC71"
            android:textSize="18sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:gravity="center"
            android:minLines="1" />

        <TextView
            android:id="@+id/lcdLine2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text=""
            android:textColor="#2ECC71"
            android:textSize="20sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:gravity="center"
            android:minLines="1" />

        <TextView
            android:id="@+id/lcdLine3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text=""
            android:textColor="#2ECC71"
            android:textSize="16sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:minLines="1" />

        <TextView
            android:id="@+id/lcdLine4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text=""
            android:textColor="#2ECC71"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:minLines="1" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_drawable"
            android:visibility="invisible" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="←"
            android:textColor="#2ECC71"
            android:textSize="22sp"
            android:background="@drawable/btn_ctrl"
            android:fontFamily="monospace"
            android:layout_marginEnd="4dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnMenu"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="МЕНЮ"
            android:textColor="#2ECC71"
            android:textSize="16sp"
            android:background="@drawable/btn_ctrl"
            android:fontFamily="monospace"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnArm"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="ВЗВОД"
            android:textColor="#FF3B30"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/btn_arm"
            android:fontFamily="monospace"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:orientation="vertical"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn1"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:text="1" android:textColor="#2ECC71" android:textSize="22sp"
                android:background="@drawable/btn_ctrl" android:fontFamily="monospace"
                android:layout_margin="3dp" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn2"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:text="2" android:textColor="#2ECC71" android:textSize="22sp"
                android:background="@drawable/btn_ctrl" android:fontFamily="monospace"
                android:layout_margin="3dp" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn3"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:text="3" android:textColor="#2ECC71" android:textSize="22sp"
                android:background="@drawable/btn_ctrl" android:fontFamily="monospace"
                android:layout_margin="3dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn4"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:text="4" android:textColor="#2ECC71" android:textSize="22sp"
                android:background="@drawable/btn_ctrl" android:fontFamily="monospace"
                android:layout_margin="3dp" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn5"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:text="5" android:textColor="#2ECC71" android:textSize="22sp"
                android:background="@drawable/btn_ctrl" android:fontFamily="monospace"
                android:layout_margin="3dp" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn6"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:text="6" android:textColor="#2ECC71" android:textSize="22sp"
                android:background="@drawable/btn_ctrl" android:fontFamily="monospace"
                android:layout_margin="3dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn7"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:text="7" android:textColor="#2ECC71" android:textSize="22sp"
                android:background="@drawable/btn_ctrl" android:fontFamily="monospace"
                android:layout_margin="3dp" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn8"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:text="8" android:textColor="#2ECC71" android:textSize="22sp"
                android:background="@drawable/btn_ctrl" android:fontFamily="monospace"
                android:layout_margin="3dp" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn9"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:text="9" android:textColor="#2ECC71" android:textSize="22sp"
                android:background="@drawable/btn_ctrl" android:fontFamily="monospace"
                android:layout_margin="3dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnStar"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:text="*" android:textColor="#FFB800" android:textSize="22sp"
                android:background="@drawable/btn_ctrl" android:fontFamily="monospace"
                android:layout_margin="3dp" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn0"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:text="0" android:textColor="#2ECC71" android:textSize="22sp"
                android:background="@drawable/btn_ctrl" android:fontFamily="monospace"
                android:layout_margin="3dp" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnHash"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:text="#" android:textColor="#FFB800" android:textSize="22sp"
                android:background="@drawable/btn_ctrl" android:fontFamily="monospace"
                android:layout_margin="3dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>