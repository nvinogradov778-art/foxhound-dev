<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#0D0D0D">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.65"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#1A1A1A"
            android:padding="4dp">

            <View
                android:id="@+id/status_indicator"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center"
                android:background="@drawable/status_green" />

            <TextView
                android:id="@+id/hud_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="#00FF41"
                android:text=" [ NODE: LOCAL_TTY ] | [ UPTIME: 00:00:00 ] | [ STR: 99% ] | [ 00:00:00 ]"
                android:shadowColor="#00FF41"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="2" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/scroll_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/log_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:textColor="#00FF41"
                android:background="#0D0D0D"
                android:padding="4dp"
                android:shadowColor="#00FF41"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="1.5"
                android:text="" />
        </ScrollView>

        <EditText
            android:id="@+id/input_field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="14sp"
            android:textColor="#00FF41"
            android:background="@drawable/edit_text_background"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:enabled="false"
            android:focusableInTouchMode="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.35"
        android:orientation="vertical"
        android:padding="8dp"
        android:gravity="center">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="14sp"
            android:textColor="#00FF41"
            android:gravity="center"
            android:text="КЛАВИШИ" />

        <GridLayout
            android:id="@+id/keyboard_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="4"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btn_1"
                style="@style/TerminalButton"
                android:text="1" />
            <Button
                android:id="@+id/btn_2"
                style="@style/TerminalButton"
                android:text="2" />
            <Button
                android:id="@+id/btn_3"
                style="@style/TerminalButton"
                android:text="3" />
            <Button
                android:id="@+id/btn_4"
                style="@style/TerminalButton"
                android:text="4" />
            <Button
                android:id="@+id/btn_5"
                style="@style/TerminalButton"
                android:text="5" />
            <Button
                android:id="@+id/btn_6"
                style="@style/TerminalButton"
                android:text="6" />
            <Button
                android:id="@+id/btn_7"
                style="@style/TerminalButton"
                android:text="7" />
            <Button
                android:id="@+id/btn_8"
                style="@style/TerminalButton"
                android:text="8" />
            <Button
                android:id="@+id/btn_9"
                style="@style/TerminalButton"
                android:text="9" />
            <Button
                android:id="@+id/btn_left"
                style="@style/TerminalButton"
                android:text="&lt;" />
            <Button
                android:id="@+id/btn_0"
                style="@style/TerminalButton"
                android:text="0" />
            <Button
                android:id="@+id/btn_right"
                style="@style/TerminalButton"
                android:text="&gt;" />
        </GridLayout>

        <Button
            android:id="@+id/btn_enter"
            style="@style/TerminalButtonEnter"
            android:text="ENTER" />
    </LinearLayout>
</LinearLayout>