<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D"
    android:padding="20dp">

    <TextView
        android:id="@+id/game_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:text="ПЕРЕХВАТ СИГНАЛА"
        android:textSize="24sp"
        android:textColor="#00FF41"
        android:fontFamily="monospace"
        android:shadowColor="#00FF41"
        android:shadowRadius="4"
        android:layout_marginTop="20dp" />

    <!-- Подзаголовок/инструкция -->
    <TextView
        android:id="@+id/game_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/game_title"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:text=""
        android:textSize="16sp"
        android:textColor="#FFFF00"
        android:fontFamily="monospace"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/game_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/game_subtitle"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/round_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="РАУНД: 0/0"
            android:textColor="#00FF41"
            android:textSize="18sp"
            android:fontFamily="monospace"
            android:layout_marginEnd="30dp" />

        <TextView
            android:id="@+id/errors_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ОШИБКИ: 0/0"
            android:textColor="#FF4444"
            android:textSize="18sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <com.example.valhallaterminal.SignalScaleView
        android:id="@+id/signal_scale"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_below="@id/game_info"
        android:layout_marginTop="40dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp" />

    <Button
        android:id="@+id/game_enter_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/signal_scale"
        android:layout_marginTop="40dp"
        android:text="ENTER"
        android:textSize="24sp"
        android:background="@drawable/button_enter_game"
        android:textColor="#00FF41"
        android:fontFamily="monospace"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:minHeight="70dp"
        android:gravity="center"
        android:visibility="gone" />

    <Button
        android:id="@+id/game_action_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/game_enter_btn"
        android:layout_marginTop="10dp"
        android:text="СТАРТ"
        android:textSize="22sp"
        android:background="@drawable/button_selector"
        android:textColor="#00FF41"
        android:fontFamily="monospace"
        android:padding="16dp"
        android:visibility="gone" />

</RelativeLayout>