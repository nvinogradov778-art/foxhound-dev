<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TerminalButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:textSize">24sp</item>
        <item name="android:background">@drawable/button_selector</item>
        <item name="android:textColor">#00FF41</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TerminalButtonEnter" parent="TerminalButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">0</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:padding">20dp</item>
        <item name="android:backgroundTint">#1A3A1A</item>
        <item name="android:background">@drawable/button_enter_selector</item>
    </style>

</resources>